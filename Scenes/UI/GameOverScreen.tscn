[ext_resource type="Script" path="res://Scripts/UI/game_over_screen.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://Assets/UI/Play Again Screen.png" id="2_mockup"]

[sub_resource type="Shader" id="Shader_game_over_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_lod = 5.0;
uniform float dim_amount = 0.42;

void fragment() {
	vec4 sampled_color = textureLod(screen_texture, SCREEN_UV, blur_lod);
	COLOR = vec4(sampled_color.rgb * dim_amount, 1.0);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_game_over_blur"]
shader = SubResource("Shader_game_over_blur")
shader_parameter/blur_lod = 5.0
shader_parameter/dim_amount = 0.42

