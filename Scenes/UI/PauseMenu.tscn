[sub_resource type="Shader" id="Shader_pause_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_lod = 5.0;
uniform float dim_amount = 0.42;

void fragment() {
	vec4 sampled_color = textureLod(screen_texture, SCREEN_UV, blur_lod);
	COLOR = vec4(sampled_color.rgb * dim_amount, 1.0);
}"

